<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.7</version> 
    <relativePath/>
  </parent>
  
  <groupId>guildmaster</groupId>
  <artifactId>guildmaster</artifactId>
  <version>1.0.4</version>
  <packaging>pom</packaging>
  <name>Guildmaster - Reusable Modules</name>
  
  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
  </properties>
  
  <modules>
    <module>Sentinel/sentinel-core</module>
    <module>Sentinel/sentinel-starter</module>
    <module>Archivist/archivist-core</module>
    <module>Archivist/archivist-starter</module>
    <module>Bard/bard-core</module>
    <module>Bard/bard-starter</module>
  </modules>
  
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  
  <distributionManagement>
    <repository>
        <id>github</id>
        <name>GitHub Packages</name>
        <url>https://maven.pkg.github.com/gown-dev/archivist</url>
    </repository>
  </distributionManagement>
    
</project>